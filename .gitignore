# ==========================================================================
#  Dependencias
# ==========================================================================
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# ==========================================================================
#  Salida de build
#  Todo lo que produce `npm run build` se regenera con ese comando.
#  Ojo: `public/` NO va aquí, es la fuente de los assets que se publican.
# ==========================================================================
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# ==========================================================================
#  Variables de entorno y secretos
#  Crítico: evita subir credenciales, tokens o claves de API.
# ==========================================================================
.env
.env.*
*.env
!.env.example

# ==========================================================================
#  Cachés
# ==========================================================================
.vite/
.cache/
.parcel-cache/
.npm/
.temp/
.turbo/
coverage/
.nyc_output/

# ==========================================================================
#  Logs y depuración
# ==========================================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
debug.log

# ==========================================================================
#  Archivos de trabajo temporales
#  Scripts de un solo uso, capturas de verificación, comparativas de diseño
#  y resultados de pruebas que se generan en local y no aportan nada al repo.
#  Convención: prefijo `_` = temporal (igual que `_tmp/`, `_favicon/`, etc.)
# ==========================================================================
_*/
_*
!_gitignore
tmp/
temp/
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*.swo
*~
*-check.png
*-review.png
*-test.png
*-preview.png
*-before.png
*-after.png

# ==========================================================================
#  Sistema operativo
#  macOS
# ==========================================================================
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.VolumeIcon.icns
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
# Linux
.directory
.Trash-*
.nfs*

# ==========================================================================
#  Editores e IDE
#  .vscode va entera ignorada: las preferencias son personales y este
#  proyecto no comparte ninguna configuración de editor.
# ==========================================================================
.vscode/
.idea/
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates
*.ntvs*
*.njsproj
*.project
.history/

# ==========================================================================
#  Documentos de trabajo internos
#  El repo es PÚBLICO. Estos dos archivos son notas de trabajo: decisiones,
#  mediciones, precios en borrador y opinión sobre lo que pidió el cliente. No
#  contienen secretos (los teléfonos y horarios ya están en la web), pero no son
#  documentación del proyecto y no tienen por qué estar a la vista.
#  Siguen en el disco: se usan al trabajar y no se versionan.
#  OJO: esto solo los saca a partir de ahora. Los que ya estaban en commits
#  anteriores siguen visibles en el historial; para sacarlos del todo hay que
#  reescribir la historia, y eso obliga a forzar el push.
# ==========================================================================
MEMORY.md
AGENTS.md

# ==========================================================================
#  Plataformas de despliegue
#  Este proyecto es estático y se publica con `npm run build`. Estas carpetas son
#  configuración local de cada hosting y no van al repo.
# ==========================================================================
.vercel/
.netlify/

# ==========================================================================
#  Configuración local por máquina
# ==========================================================================
*.local
.env.local
.env.*.local
